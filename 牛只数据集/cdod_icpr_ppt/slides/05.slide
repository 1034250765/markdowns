<Slide style={{ padding: '32px 60px', background: '#FFFFFF' }}>
  <Box style={{
    flexDirection: 'column',
    width: '100%',
    height: '100%',
    gap: 16,
  }}>
    {/* 页眉 */}
    <Box style={{
      flexDirection: 'row',
      alignItems: 'center',
      justifyContent: 'space-between',
      height: 40,
      borderBottom: '2px solid #1E4FA8',
    }}>
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#0E3F8C' }}>实验设置</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>Experimental Setup</Text>
    </Box>
    {/* 数据集表格 */}
    <Box style={{ flexDirection: 'column', gap: 8 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>数据集统计</Text>
      <Table
        style={{ width: '100%', height: 170 }}
        defaultTextStyle={{ fontSize: 15, textAlign: 'center', color: '#1A2230' }}
        defaultCellStyle={{
          border: {
            left: { width: 1, color: '#D6DCE5' },
            right: { width: 1, color: '#D6DCE5' },
            top: { width: 1, color: '#D6DCE5' },
            bottom: { width: 1, color: '#D6DCE5' },
          },
        }}
        cells={[
          [
            { text: '数据集', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#1E4FA8' } } },
            { text: '图像数', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#1E4FA8' } } },
            { text: '类别数', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#1E4FA8' } } },
            { text: '设置类型', textStyle: { bold: true, color: '#fff' }, cellStyle: { background: { color: '#1E4FA8' } } },
          ],
          ['COCO', '5,000', '80', 'Agnostic'],
          ['Objects365', '38,000', '365', 'Agnostic'],
          ['Cityscapes', '500', '8', 'Specific'],
          ['BDD100K', '10,000', '10', 'Specific'],
        ]}
      />
    </Box>
    {/* 下方两栏 */}
    <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
      <Box style={{
        flex: 1,
        background: '#F0F5FC',
        borderRadius: 8,
        padding: 18,
        gap: 10,
      }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>训练协议</Text>
        <Box style={{ flexDirection: 'column', gap: 8 }}>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 固定训练配方，每个源数据集独立训练一个模型</Text>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 架构：Faster R-CNN + ResNet-50 FPN</Text>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 框架：PyTorch + MMDetection，标准 1× schedule</Text>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 目标评估为零样本，无目标域访问</Text>
        </Box>
      </Box>
      <Box style={{
        flex: 1,
        background: '#FFFFFF',
        border: '1px solid #D6DCE5',
        borderRadius: 8,
        padding: 18,
        gap: 10,
      }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>评估设置</Text>
        <Box style={{ flexDirection: 'column', gap: 8 }}>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 报告完整 4×4 训练→测试迁移矩阵</Text>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 指标：mAP @ IoU 0.50–0.95</Text>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 语义相似度：CLIP ViT-L/14 文本嵌入</Text>
          <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>• 硬件：NVIDIA RTX A5000 (24 GB)</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
